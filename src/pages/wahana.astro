---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FooterCTA from '../components/FooterCTA.astro';
import '../styles/catalog-cards.css';
import { buildBreadcrumbSchema, getSiteBase } from '../lib/seo';

// Kategori Filter (1:1 Mirip Style GoUncharted di Akomodasi)
const categories = [
  { id: "all", label: "Semua Wahana" },
  { id: "adventure", label: "ATV & Offroad" },
  { id: "equestrian", label: "Wisata Berkuda" },
  { id: "wellness", label: "Pine Forest Spa" },
  { id: "edukasi", label: "Mini Zoo Edupark" },
  { id: "outbound", label: "Outbound B2B" }
];

// Koleksi 6 Sektor Aktivitas & Wahana Jolotundo (Editorial Grid Architecture 1:1 Akomodasi)
const activities = [
  {
    index: "01",
    id: "atv-adventure",
    name: "ATV Adventure",
    category: "adventure",
    tier: "Offroad & Adrenaline",
    setting: "River & Pine Trail",
    capacity: "Single & Tandem",
    tagline: "Sensasi memacu adrenalin di atas quad bike melintasi bebatuan sungai alami dan jalur tanah basah hutan pinus lereng Wilis.",
    pills: ["Short & Long Track", "Mulai Rp 50.000", "Helm & Guide", "3 Sesi Harian"],
    image: "/images/activities/atv/atv1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "02",
    id: "jeep-offroad",
    name: "Fun Offroad Jeep 4x4",
    category: "adventure",
    tier: "4x4 Mountain Overland",
    setting: "Ngleyangan & Wilis",
    capacity: "Rombongan / Jeep",
    tagline: "Ekspedisi overland menembus tanjakan ekstrem, rute Air Terjun Ngleyangan hingga jalur luar Bandara Dhoho Kediri.",
    pills: ["Rp 600.000 / Mobil Jeep", "Free Snack & Drink", "Air Terjun Ngleyangan", "Driver Berpengalaman"],
    image: "/images/activities/jeep/jeep4.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "03",
    id: "wisata-berkuda",
    name: "Wisata Berkuda",
    category: "equestrian",
    tier: "Equestrian & Forest Trail",
    setting: "Pine Arena & Trails",
    capacity: "Anak & Dewasa",
    tagline: "Ketenangan ritmis menunggang kuda terlatih mengitari arena pinus asri dan semilir kabut dingin pegunungan.",
    pills: ["Mulai Rp 25.000", "Horse Riding Eksklusif", "Dokumentasi Foto", "Sewa Sepatu & Helm"],
    image: "/images/activities/horse/horse1.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "04",
    id: "forest-spa",
    name: "Pine Forest Spa",
    category: "wellness",
    tier: "Wellness & Deep Healing",
    setting: "Pine Canopy & River",
    capacity: "Umum & Deluxe Camp",
    tagline: "Sensasi pemulihan raga menyeluruh dengan sentuhan aromaterapi rempah alami dan alunan gemericik air sungai pegunungan.",
    pills: ["Refleksi Kaki & Tangan", "Mulai Rp 60.000", "Body Massage Tradisional", "Lulur Herbal"],
    image: "/images/activities/forest-spa.jpg",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "05",
    id: "mini-zoo",
    name: "Mini Zoo Edupark",
    category: "edukasi",
    tier: "Edukasi Satwa & Keluarga",
    setting: "Pine Forest Zoo",
    capacity: "Anak, Balita & Keluarga",
    tagline: "Interaksi hangat mengenal dan memberi makan satwa jinak ramah anak di bawah naungan sejuknya hutan pinus lereng Wilis.",
    pills: ["Gratis Kunjungan", "Rusa Totol & Domba", "Ramah Anak & Balita", "Area Terbuka Pinus"],
    image: "/images/activities/zoo/zoo1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "06",
    id: "outbound-gathering",
    name: "Outbound & Gathering",
    category: "outbound",
    tier: "Corporate & Community B2B",
    setting: "Pinus Green Lawn",
    capacity: "50 s/d 150+ Peserta",
    tagline: "Program dinamika kelompok terintegrasi untuk korporasi, BUMN, dinas kedinasan, dan komunitas dengan 9 fasilitas all-inclusive.",
    pills: ["Mulai Rp 25.000 / Org", "9 Fasilitas Include", "Trainer & Sound System", "Spanduk & P3K"],
    image: "/images/activities/outbond/outbond1.avif",
    gridClass: "grid-col-5 camp-card-hero"
  }
];
const siteBase = getSiteBase(Astro.site);
const breadcrumbSchema = buildBreadcrumbSchema(siteBase, [
  { name: "Beranda", path: "/" },
  { name: "Wahana & Rekreasi", path: "/wahana/" }
]);
---

<Layout 
  title="Wahana & Rekreasi — Jolotundo Glamping & Edupark"
  description="Wahana seru di Jolotundo Nganjuk: ATV Adventure, Jeep Offroad 4x4, berkuda, Mini Zoo ramah anak, forest spa, dan outbound gathering."
  image="/og-image.jpg"
  keywords="jolotundo, wahana jolotundo, atv jolotundo, jeep offroad nganjuk, mini zoo jolotundo, berkuda nganjuk, outbound jolotundo"
  schema={breadcrumbSchema}
>
  <!-- Floating Expanding Pill Navbar -->
  <Navbar />

  <!-- Main Canvas: Warm Stone Background (GoUncharted Luxury Editorial) -->
  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white pb-20">

    <!-- ========================================================================= -->
    <!-- 1. FULLSCREEN EDITORIAL HERO (1:1 RIVER BREEZE STYLE)                     -->
    <!-- ========================================================================= -->
    <header 
      id="wahana-hero" 
      class="relative h-screen h-[100dvh] min-h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-[#141110] text-[#f4efe6] select-none"
    >
      <!-- Parallax Translate-Y Background Layer -->
      <div 
        id="wahana-hero-parallax-layer"
        class="absolute inset-x-0 w-full h-[125%] -top-[12.5%] pointer-events-none will-change-transform z-0"
        style="transform: translate3d(0, 0px, 0);"
      >
        <img 
          src="/images/activities/horse/horse1.avif" 
          alt="Wana Wisata & Rekreasi Jolotundo Glamping & Edupark" 
          class="w-full h-full object-cover object-center scale-105"
          fetchpriority="high"
          loading="eager"
        />
        <!-- Atmospheric Vignettes / Dual Scrim for Editorial Typography Contrast -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90 pointer-events-none"></div>
        <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
      </div>

      <!-- Top Spacer to clear floating pill navbar -->
      <div class="h-20 sm:h-28 shrink-0"></div>

      <!-- Center Display Typography (Pure River Breeze Clean Brutalist-Luxury) -->
      <div class="relative z-10 flex flex-col items-center justify-center text-center px-5 max-w-4xl mx-auto my-auto w-full py-4 sm:py-8">
        
        <!-- Subtle Monospaced Eyebrow Kicker -->
        <span class="text-[10px] sm:text-xs font-mono-tag tracking-[0.2em] sm:tracking-[0.28em] text-[#d8c39e] uppercase mb-3 sm:mb-5 block">
          — FIELD GUIDE & RECREATION
        </span>

        <!-- Clean, Powerful & Elegant Title -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-[-0.03em] text-white leading-[1.02] sm:leading-[0.96] font-sans drop-shadow-lg"> 
          Wahana & Rekreasi.
        </h1>

        <!-- Simple, Clean & Poetic Subtitle -->
        <p class="text-xs sm:text-base md:text-lg font-sans text-white/80 max-w-md sm:max-w-xl mx-auto mt-3 sm:mt-5 drop-shadow leading-relaxed font-light">
          Petualangan alam bebas di lereng Gunung Wilis. Dari pacuan adrenalin ATV & Jeep Offroad hingga ketenangan berkuda dan eduwisata ramah keluarga.
        </p>

        <!-- Clean Subtle Action Links -->
        <div class="flex items-center gap-3 sm:gap-6 mt-6 sm:mt-10 text-[11px] sm:text-xs font-mono-tag tracking-wider uppercase">
          <a 
            href="https://wa.me/6282249828998?text=Halo%20Admin%20Jolotundo%2C%20saya%20tertarik%20tanya%20info%20dan%20reservasi%20wahana%20rekreasi."
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 sm:px-5 py-2.5 sm:py-3 bg-[#d8c39e] hover:bg-white text-[#141110] font-bold transition-colors shadow-md flex items-center gap-1.5"
          >
            <span>Reservasi Wahana</span>
            <span>↗</span>
          </a>
          <a 
            href="#activity-catalog-grid" 
            class="px-3 py-2 text-white/80 hover:text-white transition-colors border-b border-white/40 pb-0.5 flex items-center gap-1"
          >
            <span>Katalog Wahana</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Bottom Metadata Bar: Clean Single Row on Mobile, Full on Desktop -->
      <div class="relative z-10 w-full px-5 sm:px-12 lg:px-16 pb-4 sm:pb-8 pt-3 border-t border-white/15 bg-gradient-to-t from-black/85 via-black/40 to-transparent shrink-0">
        <div class="max-w-[1680px] mx-auto flex items-center justify-center gap-2 text-[10px] sm:text-xs font-mono-tag tracking-wider sm:tracking-widest uppercase text-white/70">
          
          <div class="flex items-center gap-2 sm:gap-6 text-white/60 shrink-0">
            <span class="hidden sm:inline">06 KLUSTER AKTIVITAS</span>
            <span class="hidden sm:inline">•</span>
            <span>ELEVASI ±800 MDPL</span>
            <span>•</span>
            <span class="text-[#d8c39e] font-bold">ALL SEASONS</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. EDITORIAL CATEGORY FILTER (1:1 GoUncharted Akomodasi Style)             -->
    <!-- ========================================================================= -->
    <header class="catalog-filter-bar px-6 sm:px-10 lg:px-14 xl:px-20 text-center flex flex-col items-center pt-16 sm:pt-20 pb-8">
      
      <!-- Top Small Spaced Kicker: EXPLORE BY CATEGORY -->
      <span class="text-[11px] sm:text-xs font-mono-tag text-[#141110]/60 tracking-[0.25em] uppercase mb-4 sm:mb-5 block">
        EXPLORE BY ACTIVITY
      </span>

      <!-- Category Filter Typography Line (All Mountains Coast Desert... Style) -->
      <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 gap-y-3.5 max-w-4xl mx-auto py-2">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`category-filter-btn text-lg sm:text-2xl lg:text-[24px] font-normal tracking-tight font-sans transition-all duration-200 cursor-pointer ${
              idx === 0 
                ? 'text-[#141110] font-bold border-b border-[#141110]' 
                : 'text-[#141110]/45 hover:text-[#141110] border-b border-transparent'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </nav>

    </header>

    <!-- Sub-Bar / Metadata Divider: "KATALOG / 05 WAHANA & REKREASI" -->
    <div class="px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto mb-8 sm:mb-10">
      <div class="flex items-center justify-between py-3.5 border-b border-[#141110]/15 text-xs font-mono-tag text-[#141110]/70 uppercase tracking-wider">
        <div class="flex items-center gap-2">
          <span class="font-bold text-[#141110]">KATALOG</span>
          <span class="text-[#141110]/40">/</span>
          <span>06 WAHANA & REKREASI</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-[#141110]/50 text-[11px]">
          <span>[ LERENG GUNUNG WILIS • ±800 MDPL ]</span>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. CARDS GRID: 1:1 DENGAN MENU CAMPING & GLAMPING (AKOMODASI)             -->
    <!-- ========================================================================= -->
    <section class="catalog-section px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto mb-24 sm:mb-32">
      <div id="activity-catalog-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
        {activities.map((act) => (
          <article 
            data-category={act.category}
            class={`camp-card group relative overflow-hidden bg-[#141110] border border-[#141110]/20 select-none cursor-pointer w-full ${act.gridClass}`}
            tabindex="0"
            role="button"
            aria-label={`Lihat detail ${act.name}`}
            onclick={`window.location.href = '/wahana/${act.id}/';`}
          >
            
            <!-- Background Image with Butter-Smooth Scale on Hover/Active -->
            <img 
              src={act.image} 
              alt={act.name + " - Jolotundo Glamping & Edupark"}
              class="camp-img absolute inset-0 w-full h-full object-cover object-center transform scale-100 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Clean Atmospheric Gradient Layer -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/35 opacity-90 group-hover:opacity-95 transition-opacity duration-500 pointer-events-none"></div>

            <!-- Top Clean Typographic Meta Row -->
            <div class="absolute top-5 left-5 right-5 sm:top-7 sm:left-8 sm:right-8 flex items-center justify-between gap-4 pointer-events-none z-10">
              <span class="text-[11px] font-mono-tag tracking-[0.25em] text-[#d8c39e] uppercase font-bold drop-shadow-sm">
                NO. {act.index}
              </span>
              <span class="text-[10px] sm:text-[11px] font-mono-tag tracking-[0.18em] text-white/80 uppercase text-right drop-shadow-sm truncate">
                {act.setting}
              </span>
            </div>

            <!-- In-Image Content Overlay (Minimal Clean Layout) -->
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-8 lg:p-10 flex flex-col justify-end z-10 pointer-events-none">
              
              <!-- Activity Name (Visible Idle -> Translates Upwards on Hover/Active) -->
              <div class="camp-title-wrap">
                <span class="text-[10px] sm:text-[11px] font-mono-tag text-[#d8c39e]/95 uppercase tracking-[0.22em] block mb-1.5 font-semibold">
                  {act.tier}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white uppercase leading-[1.05] font-sans drop-shadow-md">
                  {act.name}
                </h3>
              </div>

              <!-- Collapsible Reveal Drawer (Hidden on Idle -> Clean Reveal on Hover/Active) -->
              <div class="camp-drawer">
                <div class="camp-drawer-inner">
                  <div class="camp-drawer-content pt-3 flex flex-col gap-3 pointer-events-auto">
                    
                    <!-- Concise 2-Line Tagline -->
                    <p class="text-xs sm:text-sm text-white/80 font-light leading-relaxed max-w-lg line-clamp-2">
                      {act.tagline}
                    </p>

                    <!-- Clean Single-Line Spec Summary (Replaces Noisy Boxed Pills) -->
                    <p class="text-[10px] sm:text-[11px] font-mono-tag text-[#d8c39e]/85 tracking-wider uppercase truncate">
                      {act.pills.slice(0, 3).join('  ·  ')}
                    </p>

                    <!-- Clean Action Bar (Responsive Full-Width on Mobile, Compact on Desktop) -->
                    <div class="pt-3 border-t border-white/15 flex items-center justify-between gap-3">
                      <a
                        href={`/wahana/${act.id}/`}
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-[#f4efe6] hover:bg-white text-[#141110] font-mono-tag text-[11px] font-bold uppercase tracking-wider transition-all duration-200 border border-[#f4efe6] hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] whitespace-nowrap"
                      >
                        <span>Lihat Detail</span>
                        <span>↗</span>
                      </a>
                    </div>

                  </div>
                </div>
              </div>

            </div>

          </article>
        ))}
      </div>
    </section>

  </main>

  <!-- Global Footer -->
  <FooterCTA />
</Layout>

<!-- ========================================================================= -->
<!-- STYLES: 1:1 GOUNCHARTED CARD GRID & SPOTLIGHT (IDENTIK DENGAN AKOMODASI) -->
<!-- ========================================================================= -->
<script>
  import { initHeroLayerParallax } from '../scripts/heroParallax';
  import { initCatalogGrid } from '../scripts/catalogFilter';

  initHeroLayerParallax({
    sectionId: 'wahana-hero',
    layerId: 'wahana-hero-parallax-layer',
    speed: 0.32,
    bufferPx: 50,
  });
  initCatalogGrid({
    gridId: 'activity-catalog-grid',
    onlyToggleBelowDesktop: true,
  });
</script>
