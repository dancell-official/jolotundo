---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FooterCTA from '../components/FooterCTA.astro';
import JourneyUpgradeStack from '../components/JourneyUpgradeStack.astro';
import GrillStickyScroll from '../components/GrillStickyScroll.astro';
import RentalGearSection from '../components/RentalGearSection.astro';
import '../styles/catalog-cards.css';
import { buildBreadcrumbSchema, getSiteBase } from '../lib/seo';

// Data Lengkap 7 Akomodasi Jolotundo (Varied Dynamic Editorial Grid Architecture)
const accommodations = [
  {
    index: "01",
    id: "deluxe-camp",
    name: "Deluxe Camp",
    category: "cabin",
    tier: "Premium Hospitality",
    setting: "Riverside & Pine Canopy",
    capacity: "2 Orang",
    tagline: "Kabin kayu jati berpendingin udara di tepi sungai berbatu, memadukan kenyamanan hotel dengan alunan gemericik air alami.",
    pills: ["Tepi Sungai", "±800 MDPL", "Kabin AC", "Maks 2 Tamu"],
    image: "/images/accommodations/deluxecamp/deluxe1.avif",
    editorialImage: "/images/accommodations/deluxecamp/deluxe1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "02",
    id: "superior-camp",
    name: "Superior Camp",
    category: "cabin",
    tier: "Premium Hospitality",
    setting: "Terraced Pine Hill",
    capacity: "2 Orang",
    tagline: "Kabin berpendingin udara modern dengan fasilitas lengkap, Smart TV, tea maker kit, dan water heater untuk kenyamanan prima.",
    pills: ["Terraced Hill", "Kabin AC", "Smart TV", "Maks 2 Tamu"],
    image: "/images/accommodations/superior/superior.avif",
    editorialImage: "/images/accommodations/superior/superior.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "03",
    id: "korean-glamping",
    name: "Korean Glamping",
    category: "forest",
    tier: "Experiential Glamping",
    setting: "Pine Lawn Garden",
    capacity: "3 s/d 6 Orang",
    tagline: "Glamping bergaya Korea yang memadukan keindahan alam dengan suasana hangat, kompor set lengkap, dan pesta BBQ di bawah kabut pinus.",
    pills: ["Taman Pinus", "BBQ Picnic", "Aesthetic Tent", "3–6 Tamu"],
    image: "/images/accommodations/koreanglamping/korean1.avif",
    editorialImage: "/images/accommodations/koreanglamping/korean1.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "04",
    id: "indian-camp",
    name: "Indian Camp",
    category: "forest",
    tier: "Experiential Glamping",
    setting: "Pine Forest Lawn",
    capacity: "3 s/d 6 Orang",
    tagline: "Camping dengan gaya indian memberikan nuansa alam, petualangan, serta suasana etnik yang unik, nyaman, dan lengkap dengan perlengkapan BBQ.",
    pills: ["Gaya Indian Etnik", "Kapasitas 3 & 6 Pax", "Mulai Rp 600K", "BBQ & Cooking Set"],
    image: "/images/accommodations/indian/indian1.avif",
    editorialImage: "/images/accommodations/indian/indian1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "05",
    id: "river-camp",
    name: "River Camp",
    category: "river",
    tier: "Experiential Glamping",
    setting: "Direct Riverside Deck",
    capacity: "2 Orang",
    tagline: "Terapi alam terbaik dengan alunan simfoni gemericik air sungai alami tepat di depan teras panggung kayu Anda sepanjang malam.",
    pills: ["Dek Sungai", "Gemericik Air", "Double Bed", "Maks 2 Tamu"],
    image: "/images/accommodations/rivercamp/river1.avif",
    editorialImage: "/images/accommodations/rivercamp/river1.avif",
    gridClass: "grid-col-7 camp-card-hero"
  },
  {
    index: "06",
    id: "pinus-camp",
    name: "Pinus Camp & Plus",
    category: "forest",
    tier: "Rustic & Nature",
    setting: "Pine Canopy & Small Creek",
    capacity: "2 Orang",
    tagline: "Tenda panggung kayu di tengah keteduhan ribuan pohon pinus, tersedia opsi Reguler dan Plus di tepi aliran sungai kecil.",
    pills: ["Opsi Tepi Sungai", "Dek Panggung", "Mulai Rp 250K", "2 Tamu"],
    image: "/images/accommodations/pinuscamp/pinus1.avif",
    editorialImage: "/images/accommodations/pinuscamp/pinus1.avif",
    gridClass: "grid-col-5 camp-card-hero"
  },
  {
    index: "07",
    id: "camping-ground",
    name: "Camping Ground",
    category: "ground",
    tier: "Rustic & Nature",
    setting: "Wilderness Pinus Ground",
    capacity: "4 s/d 6 Orang",
    tagline: "Area berkemah luas di bawah langit bertabur bintang untuk petualang sejati yang mendambakan esensi berkemah murni di alam bebas.",
    pills: ["Tenda Dome", "Matras Tidur", "Api Unggun", "4–6 Tamu"],
    image: "/images/accommodations/ground/ground4.avif",
    editorialImage: "/images/accommodations/ground/ground4.avif",
    gridClass: "grid-col-full camp-card-panorama"
  }
];

// Kategori Filter (1:1 Mirip Style GoUncharted "All Mountains Coast Desert...")
const categories = [
  { id: "all", label: "Semua" },
  { id: "cabin", label: "Kabin AC" },
  { id: "river", label: "Glamping Sungai" },
  { id: "forest", label: "Hutan Pinus" },
  { id: "ground", label: "Camping Ground" }
];
const siteBase = getSiteBase(Astro.site);
const breadcrumbSchema = buildBreadcrumbSchema(siteBase, [
  { name: "Beranda", path: "/" },
  { name: "Akomodasi & Glamping", path: "/akomodasi/" }
]);
---

<Layout 
  title="Akomodasi & Glamping — Jolotundo Glamping & Edupark"
  description="7 tipe penginapan di Jolotundo Nganjuk: Deluxe Camp AC, Superior Camp, Korean & Indian Glamping, River Camp, Pinus Camp & Camping Ground."
  image="/og-image.jpg"
  keywords="jolotundo, akomodasi jolotundo, glamping jolotundo, deluxe camp jolotundo, river camp jolotundo, korean glamping nganjuk, indian camp jolotundo"
  schema={breadcrumbSchema}
>
  <!-- Floating Expanding Pill Navbar -->
  <Navbar />

  <!-- Main Canvas: Warm Stone / Light Editorial Background (Identik GoUncharted) -->
  <main class="min-h-screen bg-[#f4efe6] text-[#141110] selection:bg-[#141110] selection:text-white">

    <!-- ========================================================================= -->
    <!-- HEADER SECTION: 1:1 GOUNCHARTED MINIMALIST EDITORIAL (CENTERED)           -->
    <!-- ========================================================================= -->
    <header class="catalog-header px-6 sm:px-10 lg:px-14 xl:px-20 text-center flex flex-col items-center">
      <h1 class="sr-only">Koleksi Akomodasi &amp; Glamping Jolotundo Nganjuk</h1>
      
      <!-- Top Small Spaced Kicker: EXPLORE BY CATEGORY -->
      <span class="text-[11px] sm:text-xs font-mono-tag text-[#141110]/60 tracking-[0.25em] uppercase mb-4 sm:mb-5 block">
        EXPLORE BY CATEGORY
      </span>

      <!-- Category Filter Typography Line (All Mountains Coast Desert... Style) -->
      <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 gap-y-3.5 max-w-4xl mx-auto py-2">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`category-filter-btn text-lg sm:text-2xl lg:text-[26px] font-normal tracking-tight font-sans transition-all duration-200 cursor-pointer ${
              idx === 0 
                ? 'text-[#141110] font-bold border-b border-[#141110]' 
                : 'text-[#141110]/45 hover:text-[#141110] border-b border-transparent'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </nav>

    </header>

    <!-- ========================================================================= -->
    <!-- SUB-BAR / METADATA DIVIDER: "LIST / INSPIRATION" (1:1 GoUncharted)        -->
    <!-- ========================================================================= -->
    <div class="px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto">
      <div class="flex items-center justify-between gap-3 py-3.5 border-b border-[#141110]/15 text-[11px] sm:text-xs font-mono-tag text-[#141110]/70 uppercase tracking-wider">
        <div class="flex items-center gap-2 whitespace-nowrap">
          <span class="font-bold text-[#141110]">LIST</span>
          <span class="text-[#141110]/40">/</span>
          <span>7 TIPE AKOMODASI</span>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <span class="hidden md:inline-block text-[#141110]/50 text-[11px]">[ LERENG GUNUNG WILIS • ±800 MDPL ]</span>
          <a
            href="https://jolotundo.netlify.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-3.5 py-1.5 bg-[#141110] hover:bg-black text-[#f4efe6] font-mono-tag text-[11px] font-bold uppercase tracking-wider transition-all duration-200 border border-[#141110] hover:shadow-md whitespace-nowrap"
          >
            <span class="hidden sm:inline">Pesan Sekarang</span>
            <span class="sm:hidden">Pesan</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- CARDS GRID: CLEAN EDITORIAL RHYTHM (7:5 -> 5:7 -> 6:6 -> 12 FULL WIDTH)  -->
    <!-- ========================================================================= -->
    <section class="catalog-section px-6 sm:px-10 lg:px-14 xl:px-20 max-w-[1680px] mx-auto">
      <div id="accommodation-catalog-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-7 lg:gap-8">
        {accommodations.map((stay) => (
          <article 
            data-category={stay.category}
            class={`camp-card group relative overflow-hidden bg-[#141110] border border-[#141110]/20 select-none cursor-pointer w-full ${stay.gridClass}`}
            tabindex="0"
            role="button"
            aria-label={`Lihat detail ${stay.name}`}
          >
            
            <!-- Background Image with Butter-Smooth Scale on Hover/Active (Always Adapts to Card via absolute inset-0) -->
            <img 
              src={stay.editorialImage || stay.image} 
              alt={stay.name + " - Jolotundo Glamping & Edupark"}
              class="camp-img absolute inset-0 w-full h-full object-cover object-center transform scale-100 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
              decoding="async"
            />

            <!-- Clean Atmospheric Gradient Layer (Protects Top & Bottom Typography Without Darkening Center Photo) -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/35 opacity-90 group-hover:opacity-95 transition-opacity duration-500 pointer-events-none"></div>

            <!-- Top Clean Typographic Meta Row (No Heavy Boxes) -->
            <div class="absolute top-5 left-5 right-5 sm:top-7 sm:left-8 sm:right-8 flex items-center justify-between gap-4 pointer-events-none z-10">
              <span class="text-[11px] font-mono-tag tracking-[0.25em] text-[#d8c39e] uppercase font-bold drop-shadow-sm">
                NO. {stay.index}
              </span>
              <span class="text-[10px] sm:text-[11px] font-mono-tag tracking-[0.18em] text-white/80 uppercase text-right drop-shadow-sm truncate">
                {stay.setting}
              </span>
            </div>

            <!-- In-Image Content Overlay (Minimal Clean Layout) -->
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-8 lg:p-10 flex flex-col justify-end z-10 pointer-events-none">
              
              <!-- Glamping Name (Visible Idle -> Glides Up Smoothly on Hover/Active) -->
              <div class="camp-title-wrap">
                <span class="text-[10px] sm:text-[11px] font-mono-tag text-[#d8c39e]/95 uppercase tracking-[0.22em] block mb-1.5 font-semibold">
                  {stay.tier}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white uppercase leading-[1.05] font-sans drop-shadow-md">
                  {stay.name}
                </h3>
              </div>

              <!-- Collapsible Reveal Drawer (Hidden on Idle -> Clean Reveal on Hover/Active) -->
              <div class="camp-drawer">
                <div class="camp-drawer-inner">
                  <div class="camp-drawer-content pt-3 flex flex-col gap-3 pointer-events-auto">
                    
                    <!-- Concise 2-Line Description -->
                    <p class="text-xs sm:text-sm text-white/80 font-light leading-relaxed max-w-lg line-clamp-2">
                      {stay.tagline}
                    </p>

                    <!-- Clean Single-Line Spec Summary (Replaces Noisy Boxed Pills) -->
                    <p class="text-[10px] sm:text-[11px] font-mono-tag text-[#d8c39e]/85 tracking-wider uppercase truncate">
                      {stay.pills.slice(0, 3).join('  ·  ')}
                    </p>

                    <!-- Clean Action Buttons (50/50 Grid on Mobile so Never Clipped, Inline on Desktop) -->
                    <div class="pt-3 border-t border-white/15 grid grid-cols-2 sm:flex sm:items-center gap-2.5 sm:gap-3">
                      <a
                        href={`/akomodasi/${stay.id}/`}
                        class="inline-flex items-center justify-center gap-1.5 px-3 sm:px-5 py-2.5 bg-white/10 hover:bg-white text-white hover:text-[#141110] font-mono-tag text-[11px] font-bold uppercase tracking-wider transition-all duration-200 border border-white/25 whitespace-nowrap"
                      >
                        <span>Lihat Detail</span>
                        <span>↗</span>
                      </a>

                      <a
                        href="https://jolotundo.netlify.app/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-1.5 px-3 sm:px-5 py-2.5 bg-[#f4efe6] hover:bg-white text-[#141110] font-mono-tag text-[11px] font-bold uppercase tracking-wider transition-all duration-200 border border-[#f4efe6] hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] whitespace-nowrap"
                      >
                        <span>Pesan Sekarang</span>
                        <span>↗</span>
                      </a>
                    </div>

                  </div>
                </div>
              </div>

            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- Section: Paket Upgrade Journey Camp (Sticky Stacking Deck) -->
    <JourneyUpgradeStack />

    <!-- Section: Paket Barbeque Grill (Vertical Sticky Split-Scroll) -->
    <GrillStickyScroll />

    <!-- Section: Rental Camping Gear & Peralatan -->
    <RentalGearSection />

  </main>

  <!-- Luxury Editorial Footer -->
  <FooterCTA />
</Layout>

<!-- ========================================================================= -->
<!-- STYLES: CINEMATIC SPOTLIGHT + HOMEPAGE CARD INTERACTION                   -->
<!-- ========================================================================= -->
<script>
  import { initCatalogGrid } from '../scripts/catalogFilter';

  initCatalogGrid({
    gridId: 'accommodation-catalog-grid',
    closeOnOutsideClick: true,
  });
</script>
