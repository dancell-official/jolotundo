---
import siteData from '../data/siteData.json';
import PartnerMarquee from './PartnerMarquee.astro';

// Split kata untuk efek Scroll-Driven Scrollytelling Reveal (GoUncharted / Apple Keynote Style)
const headlinePart1 = "Memadukan kemewahan menginap di alam dengan".split(" ");
const headlinePart2 = "pengalaman edukasi interaktif dan pariwisata berkelanjutan.".split(" ");

// Minimalist Editorial Stats (GoUncharted Typographic Style)
const editorialStats = [
  {
    code: "01",
    tag: "TRANSFORMASI",
    value: "2023",
    unit: "",
    label: "Tahun Berdiri",
    desc: "Bermula dari 4 tenda konsolidasi internal Dan Group hingga bertransformasi menjadi kawasan ekowisata terpadu."
  },
  {
    code: "02",
    tag: "ELEVASI WILIS",
    value: "±800",
    unit: "MDPL",
    label: "Udara Sejuk Pegunungan",
    desc: "Kawasan hutan pinus alami berkabut dengan gemericik air sungai jernih di Dusun Plakat, Desa Bajulan."
  },
  {
    code: "03",
    tag: "AKOMODASI",
    value: "7",
    unit: "Tipe",
    label: "Koleksi Menginap",
    desc: "Pilihan berjenjang dari Camping Ground alami, River Camp dek kayu, hingga kemewahan Deluxe Cabin AC."
  },
  {
    code: "04",
    tag: "PORTOFOLIO B2B",
    value: "100+",
    unit: "Instansi",
    label: "Mitra Korporasi & BUMN",
    desc: "Dipercaya BUMN, perbankan, dan korporat nasional sebagai destinasi resmi gathering, outbound, & rapat kerja."
  }
];

---

<!-- 
  SECTION 02: ABOUT & MANIFESTO (GoUncharted Editorial Architecture)
  - Warm Stone Editorial Canvas (#f5f1ea) with Deep Obsidian Typography (#141110)
  - Scroll-Driven Word-by-Word Text Reveal (Tadinya samar -> Terang penuh seiring scroll)
  - Clean & Breathable: Negative space, zero heavy box clutter
  - Minimalist Editorial Stats Strip (4 Kolom Tipografi Raksasa)
  - 100+ Corporate Partner Rail Marquee
-->
<section id="tentang" class="relative z-20 bg-[#f5f1ea] text-[#141110] py-24 sm:py-32 px-6 sm:px-10 lg:px-14 xl:px-20 transition-colors duration-300">
  <div class="max-w-[1680px] mx-auto flex flex-col gap-16 sm:gap-24">

    <!-- Top Eyebrow Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-[#141110]/15 gap-4">
      <div class="flex items-center gap-2.5 text-xs font-mono-tag text-[#141110]/80 tracking-widest uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-700 animate-pulse"></span>
        <span>COMPANY OVERVIEW & MANIFESTO</span>
      </div>
      <div class="text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider">
        DAN GROUP ECOSYSTEM
      </div>
    </div>

    <!-- Main Editorial Statement & Transformation Story -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Big Typographic Statement with Word Reveal -->
      <div class="lg:col-span-8 flex flex-col">
        <h2 
          id="manifesto-reveal-heading"
          class="text-3xl sm:text-5xl md:text-6xl lg:text-[3.8rem] xl:text-[4.4rem] leading-[1.08] tracking-[-0.03em] text-[#141110]"
        >
          <span class="font-light">
            {headlinePart1.map((word) => (
              <span 
                class="reveal-word inline-block mr-[0.24em] transition-opacity duration-150 ease-out will-change-[opacity]" 
                style="opacity: 0.18;"
              >
                {word}
              </span>
            ))}
          </span>
          <span class="font-bold text-emerald-950">
            {headlinePart2.map((word) => (
              <span 
                class="reveal-word inline-block mr-[0.24em] transition-opacity duration-150 ease-out will-change-[opacity]" 
                style="opacity: 0.18;"
              >
                {word}
              </span>
            ))}
          </span>
        </h2>

        <!-- Milestone Callout Minimalist -->
        <div class="mt-10 p-6 sm:p-7 bg-white/70 border border-[#141110]/10 flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono-tag px-3 py-1 uppercase tracking-wider font-semibold border border-[#141110]/20 text-[#141110]">
              EST. 2023
            </span>
            <div class="text-xs sm:text-sm text-[#141110]/80 leading-relaxed font-light">
              <strong class="font-semibold text-[#141110]">Tonggak Pencapaian:</strong> Bermula dari inisiatif 4 tenda internal Dan Group untuk gathering privat, kini berkembang menjadi destinasi ekowisata terpadu pionir di lereng Gunung Wilis.
            </div>
          </div>
          <div class="shrink-0 text-xs font-mono-tag text-[#141110]/60 tracking-wider uppercase sm:text-right">
            <span>DUSUN PLAKAT</span>
            <span class="block text-[10px] text-[#141110]/45 mt-0.5 font-normal">BUKA SETIAP HARI • 09.00–22.00</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative Story & Official Vision -->
      <div class="lg:col-span-4 flex flex-col justify-between h-full pt-2">
        <div class="space-y-5 text-sm sm:text-base text-[#141110]/80 font-light leading-relaxed">
          <p>
            <strong>Jolotundo Glamping & Edupark</strong>, bagian dari ekosistem bisnis <strong>Dan Group</strong>, adalah pelopor destinasi wisata terpadu di Kabupaten Nganjuk yang menghadirkan ruang di mana pengunjung dapat terhubung kembali dengan alam, mendalami budaya lokal, dan membangun kebersamaan.
          </p>
          <p>
            Didukung lanskap asri Desa Bajulan, kami merancang fasilitas glamping tematik, wahana petualangan seru, hingga program outbound korporat yang edukatif dan menumbuhkan karakter, dengan komitmen teguh terhadap <em>sustainable tourism</em>.
          </p>
        </div>

        <!-- Direct CTA to WA Booking & Profil -->
        <div class="pt-8 lg:pb-4">
          <a
            href={`https://wa.me/${siteData.brand.whatsapp}?text=${encodeURIComponent("Halo Admin Jolotundo, saya ingin konsultasi profil kawasan, reservasi glamping, dan paket outbound.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-xs sm:text-sm font-mono-tag font-semibold text-[#141110] hover:text-emerald-900 tracking-wider uppercase border-b-2 border-[#141110] pb-1 transition-all group"
          >
            <span>Konsultasi Reservasi & Outbound</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Editorial Key Metrics / Clean Stats Strip (Clean GoUncharted Architecture) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pt-12 border-t border-[#141110]/15">
      {editorialStats.map((stat) => (
        <div class="stat-card flex flex-col justify-between group cursor-pointer">
          <div>
            <div class="text-[11px] font-mono-tag text-[#141110]/50 uppercase tracking-widest mb-4">
              [ {stat.code} // {stat.tag} ]
            </div>
            
            <div class="flex items-baseline gap-2 mb-2">
              <span 
                class="scramble-stat text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight text-[#141110] font-sans group-hover:text-emerald-950 transition-colors inline-block tabular-nums min-w-[2ch]"
                data-scramble={stat.value}
              >
                {stat.value}
              </span>
              {stat.unit && (
                <span class="text-xs font-mono-tag text-[#141110]/60 uppercase tracking-wider font-semibold">
                  {stat.unit}
                </span>
              )}
            </div>

            <h3 class="text-xs font-mono-tag font-semibold text-[#141110] uppercase tracking-wider mb-2">
              {stat.label}
            </h3>

            <p class="text-xs sm:text-sm text-[#141110]/70 leading-relaxed font-light">
              {stat.desc}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-[#141110]/10 flex items-center justify-between text-[11px] font-mono-tag text-[#141110]/40">
            <span>OFFICIAL DATA</span>
            <span class="group-hover:text-emerald-800 group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Partner Rail Marquee (Koleksi 100+ Klien BUMN & Korporat dari Slide 20) -->
    <div id="b2b" class="pt-8 border-t border-[#141110]/15 flex flex-col gap-6 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono-tag text-[#141110]/70 tracking-wider uppercase gap-2">
        <span class="font-semibold text-[#141110]">
          [ DIPERCAYA OLEH 100+ INSTANSI BUMN, PERBANKAN & KORPORASI NASIONAL ]
        </span>
        <span class="text-[#141110]/50">OFFICIAL GATHERING & OUTBOUND PARTNER</span>
      </div>

      <!-- Vector SVG Logo Marquee Component -->
      <PartnerMarquee />
    </div>

  </div>
</section>

<!-- Scrollytelling Script: Word-by-Word Smooth Opacity Reveal & Stats Scramble -->
<script>
  import { initWordReveal } from '../scripts/wordReveal';
  import { initScrambleStats } from '../scripts/scrambleStats';

  initWordReveal({
    headingId: 'manifesto-reveal-heading',
    wordSelector: '.reveal-word',
    startFactor: 0.82,
    endFactor: 0.36,
    minOpacity: 0.18,
    rootMargin: '150px 0px',
  });
  initScrambleStats();
</script>


