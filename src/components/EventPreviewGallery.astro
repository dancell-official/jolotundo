---
import HorizontalPreviewGallery from './common/HorizontalPreviewGallery.astro';
import {
  calcGalleryScrollHeightVh,
  getEventGalleryImages,
  type GalleryImageItem,
} from '../data/galleries';

interface Props {
  venue: {
    id: string;
    index: string;
    name: string;
    category: string;
    setting: string;
    elevation: string;
    priceStarting: string;
    contactWa: string;
    contactPhone: string;
    gallery?: GalleryImageItem[];
  };
}

const { venue } = Astro.props;
const galleryImages = getEventGalleryImages(venue.id, venue.gallery || []);
const scrollHeightVh = calcGalleryScrollHeightVh(galleryImages.length, 340, 12);

const waPhone = venue.contactWa || '6282249829998';
const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(`Halo Admin Jolotundo, saya ingin informasi reservasi dan cek jadwal untuk *${venue.name}*.`)}`;
---

<HorizontalPreviewGallery
  sectionId="event-preview-gallery"
  viewportId="event-gallery-sticky-viewport"
  windowId="event-slider-window"
  trackId="event-slider-track"
  progressBarId="event-gallery-progress-bar"
  images={galleryImages}
  scrollHeightVh={scrollHeightVh}
  sectionBorderClass="border-t border-[#141110]/15"
  topBar={{
    leftText: 'PREVIEW GALLERY // SUASANA & FASILITAS VENUE',
    rightDesktopText: 'Scroll ke bawah untuk menjelajahi sudut venue',
    rightMobileText: 'Scroll untuk foto venue',
    pulseDotClass: 'bg-[#141110]',
  }}
  title={venue.name}
  subtitle={venue.setting}
  specs={[
    { value: venue.elevation || '±800 MDPL', label: 'ELEVASI' },
    { value: venue.category, label: 'KLASIFIKASI' },
    { value: 'OFFICIAL', label: 'PERHUTANI // PEMKAB' },
  ]}
  priceValue={venue.priceStarting}
  priceLabel="Tarif Resmi"
  priceLabelFirst={true}
  ctaLabel="Reservasi Hotline"
  ctaHref={waUrl}
/>
