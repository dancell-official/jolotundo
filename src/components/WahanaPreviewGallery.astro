---
import siteData from '../data/siteData.json';
import HorizontalPreviewGallery from './common/HorizontalPreviewGallery.astro';
import {
  calcGalleryScrollHeightVh,
  getActivityGalleryImages,
  type GalleryImageItem,
} from '../data/galleries';

interface Props {
  activity: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation: string;
    priceStarting: string;
    contactType: string;
    gallery?: GalleryImageItem[];
  };
}

const { activity } = Astro.props;
const galleryImages = getActivityGalleryImages(activity.id, activity.gallery || []);
const scrollHeightVh = calcGalleryScrollHeightVh(galleryImages.length, 340, 12);

const waPhone =
  activity.contactType === 'corporate'
    ? '6282249829998'
    : siteData.brand.whatsapp || '6282249828998';
const waUrl = `https://wa.me/${waPhone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Halo Admin Jolotundo Edupark, saya tertarik reservasi dan info ketersediaan untuk *${activity.name}*.`)}`;
---

<HorizontalPreviewGallery
  sectionId="wahana-preview-gallery"
  viewportId="wahana-gallery-sticky-viewport"
  windowId="wahana-slider-window"
  trackId="wahana-slider-track"
  progressBarId="wahana-gallery-progress-bar"
  images={galleryImages}
  scrollHeightVh={scrollHeightVh}
  sectionBorderClass="border-t border-[#141110]/15"
  topBar={{
    leftText: 'PREVIEW GALLERY // SUASANA & MEDAN JALUR',
    rightDesktopText: 'Scroll ke bawah untuk menjelajahi visual aktivitas',
    rightMobileText: 'Scroll untuk foto aktivitas',
    pulseDotClass: 'bg-emerald-700',
  }}
  title={activity.name}
  subtitle={activity.setting}
  specs={[
    { value: activity.elevation || '±650 MDPL', label: 'ELEVASI' },
    { value: 'ALL SEASONS', label: 'OPERASIONAL' },
    { value: 'VERIFIED', label: 'SAFETY GEAR' },
  ]}
  priceValue={activity.priceStarting}
  priceLabel={activity.priceStarting.toLowerCase().includes('gratis') ? 'Tiket Masuk' : 'Mulai Dari'}
  priceLabelFirst={true}
  ctaLabel="Reservasi Slot"
  ctaHref={waUrl}
/>
