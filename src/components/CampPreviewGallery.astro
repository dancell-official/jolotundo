---
import HorizontalPreviewGallery from './common/HorizontalPreviewGallery.astro';
import { calcGalleryScrollHeightVh, getCampGalleryImages } from '../data/galleries';

interface Props {
  camp: {
    id: string;
    index: string;
    name: string;
    tier: string;
    setting: string;
    elevation?: string;
    capacity: string;
    priceWeekday: string;
    priceWeekend: string;
    image: string;
    editorialImage?: string;
    editorialTagline?: string;
    tagline?: string;
    headline?: string;
  };
}

const { camp } = Astro.props;
const galleryImages = getCampGalleryImages(camp);
const scrollHeightVh = calcGalleryScrollHeightVh(galleryImages.length, 340, 12);
---

<HorizontalPreviewGallery
  sectionId="camp-preview-gallery"
  viewportId="gallery-sticky-viewport"
  windowId="gallery-slider-window"
  trackId="gallery-slider-track"
  progressBarId="gallery-progress-bar"
  images={galleryImages}
  scrollHeightVh={scrollHeightVh}
  title={camp.name}
  subtitle={camp.setting}
  specs={[
    { value: camp.capacity, label: 'KAPASITAS' },
    { value: camp.elevation || '±650 MDPL', label: 'ELEVASI' },
    { value: 'ALL YEAR', label: 'SEASON' },
  ]}
  priceValue={`Mulai ${camp.priceWeekday}`}
  priceLabel="TARIF RESMI PER MALAM"
  ctaLabel="Pesan Sekarang"
  ctaHref="https://jolotundo.netlify.app/"
/>
